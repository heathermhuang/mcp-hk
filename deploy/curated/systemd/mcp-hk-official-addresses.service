[Unit]
Description=mcp.hk exact-ID address batch under qualified daily policy
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
WorkingDirectory=/opt/mcp-hk-maintenance-current
ExecStart=/opt/mcp-hk-maintenance-current/deploy/curated/run-official.sh addresses 100
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
