[Unit]
Description=mcp.hk staged historical pair backfill (enable only after recovery qualification)
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
WorkingDirectory=/opt/mcp-hk-maintenance-current
ExecStart=/opt/mcp-hk-maintenance-current/deploy/curated/run-official.sh backfill
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
