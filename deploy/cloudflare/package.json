{
  "name": "mcp-hk-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build:discovery": "python3 ../../scripts/build_discovery.py",
    "pretypes": "npm run build:discovery",
    "types": "wrangler types",
